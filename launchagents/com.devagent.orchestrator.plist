<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.devagent.orchestrator</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>${HOME}/.cargo/bin:${HOME}/.opencode/bin:${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>${HOME}</string>
    <key>ORCHESTRATOR_REPO</key><string>${HOME}/work/harvey/freepeak/devagent</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${HOME}/work/harvey/freepeak/devagent/scripts/orchestrate-loop.sh</string>
  </array>
  <key>WorkingDirectory</key><string>${HOME}/work/harvey/freepeak/devagent</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${HOME}/Library/Logs/devagent-orchestrator.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/devagent-orchestrator.log</string>
  <key>ThrottleInterval</key><integer>60</integer>
</dict>
</plist>
