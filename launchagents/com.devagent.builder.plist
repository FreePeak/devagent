<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.devagent.builder</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>${HOME}/.cargo/bin:${HOME}/.opencode/bin:${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>${HOME}</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${HOME}/orca/workspaces/devagent-orchestrator-dev/scripts/build-loop.sh</string>
  </array>
  <key>WorkingDirectory</key><string>${HOME}/orca/workspaces/devagent-orchestrator-dev</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${HOME}/Library/Logs/devagent-builder.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/devagent-builder.log</string>
  <key>ThrottleInterval</key><integer>60</integer>
</dict>
</plist>
