{
  "name": "devagent",
  "version": "0.1.0",
  "description": "Autonomous backend delivery agent: ticket to tested PR",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devagent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "selfbuild": "bash scripts/selfbuild-loop.sh",
    "prdcurate": "bash scripts/prd-curator.sh",
    "selfstate": "bash scripts/selfbuild-state.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
